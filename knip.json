{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "emails/*.tsx", "scripts/*.mjs"],
  "project": ["**/*.{ts,tsx,mjs}"],
  "ignore": [
    "components/ui/**",
    "components/forms/**",
    "components/custom-datatable/**",
    "components/sidebar/**",
    "components/animated-section.client.tsx",
    "components/app-sidebar.client.tsx",
    "components/back-to-top.client.tsx",
    "components/mobile-nav.client.tsx",
    "components/scroll-fade.tsx",
    "hooks/**",
    "types/**",
    "modules/**/index.ts",
    "modules/auth/types.ts",
    "modules/auth/services/auth-service.ts",
    "modules/auth/services/index.ts",
    "modules/auth/actions/index.ts",
    "modules/account/actions/gdpr-actions.ts",
    "tests/**",
    "messages/*.d.json.ts",
    "lib/i18n-field.ts",
    "lib/i18n-helpers.ts",
    "lib/safe-action.ts",
    "lib/cors.ts",
    "lib/api-response.ts",
    "lib/query-helpers.ts",
    "lib/sanitize.ts"
  ],
  "ignoreDependencies": [
    "@better-auth/drizzle-adapter",
    "cmdk",
    "dompurify",
    "drizzle-zod",
    "entities",
    "input-otp",
    "nanoid",
    "react-day-picker",
    "recharts",
    "zustand",
    "@types/dompurify",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "pino-pretty",
    "postcss",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": ["duplicates", "exports", "types"]
}
