# ──────────────────────────────────────────────────────────
# CRITICAL — La app NO arranca sin estas variables
# ──────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth (Better Auth)
BETTER_AUTH_SECRET=generate-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────
# RECOMMENDED — Warn en dev, throw en produccion
# ──────────────────────────────────────────────────────────

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=My App <noreply@myapp.com>

# ──────────────────────────────────────────────────────────
# OPTIONAL — Features que se activan si se configuran
# ──────────────────────────────────────────────────────────

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Analytics — Google
NEXT_PUBLIC_GA4_ID=

# Background Jobs — Trigger.dev
TRIGGER_API_KEY=
TRIGGER_API_URL=

# ──────────────────────────────────────────────────────────
# MONITORING — Habilitar cuando se integre un servicio
# ──────────────────────────────────────────────────────────

# Error Monitoring (Sentry — descomentar cuando se use SentryMonitoringAdapter)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Logging (descomentar si se usa PinoLogger con transporte externo)
# LOG_LEVEL=info
