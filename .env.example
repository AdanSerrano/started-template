# ──────────────────────────────────────────────────────────
# CRITICAL — La app NO arranca sin estas variables
# ──────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Dialecto activo: postgresql (default) | mysql | sqlite | turso | singlestore
DB_DIALECT=postgresql
# Conexiones del pool. Default 5 (bueno para serverless). Súbelo en server de larga vida (Docker).
DATABASE_POOL_MAX=5

# Auth (Better Auth) - use  openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────
# RECOMMENDED — Warn en dev, throw en produccion
# ──────────────────────────────────────────────────────────

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=My App <noreply@myapp.com>

# ──────────────────────────────────────────────────────────
# OPTIONAL — Features que se activan si se configuran
# ──────────────────────────────────────────────────────────

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Analytics — Google
NEXT_PUBLIC_GA4_ID=

# Background Jobs — Trigger.dev
TRIGGER_API_KEY=
TRIGGER_API_URL=

# ──────────────────────────────────────────────────────────
# RATE LIMITING — Distribuido (Upstash Redis)
# Sin estas vars, usa rate limiting in-memory (single instance)
# ──────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────
# MONITORING — Error tracking y observabilidad
# ──────────────────────────────────────────────────────────

# Error Monitoring (Sentry)
# Si SENTRY_DSN esta configurado, se activa automaticamente
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
# Niveles: debug, info, warn, error
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────
# SECURITY — CORS y proteccion
# ──────────────────────────────────────────────────────────

# CORS — Origenes permitidos (comma-separated)
# Dejar vacio = solo same-origin
CORS_ALLOWED_ORIGINS=

# ──────────────────────────────────────────────────────────
# FEATURE FLAGS — Basados en env vars
# Convencion: FEATURE_FLAG_<NAME>=true|false
# ──────────────────────────────────────────────────────────

# FEATURE_FLAG_NEW_DASHBOARD=false
# FEATURE_FLAG_BETA_SEARCH=false

# ──────────────────────────────────────────────────────────
# DOCKER — Solo para builds containerizados
# ──────────────────────────────────────────────────────────

# Se activa automaticamente en Dockerfile, no tocar manualmente
# DOCKER_BUILD=1

# Docker Compose Production
# POSTGRES_USER=starter
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=starter
# REDIS_PASSWORD=changeme
